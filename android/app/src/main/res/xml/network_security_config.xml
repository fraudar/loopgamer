<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bloqueia trafego HTTP em texto claro na internet aberta por padrao;
         conexoes remotas usam HTTPS com CAs padrao do sistema. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Permite HTTP local para instancias RomM em loopback/LAN/mDNS.
         Nota: o parser XML do Android aceita hostnames e IPs especificos
         (nao suporta wildcards/CIDR como 192.168.0.0/16). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
        <domain includeSubdomains="true">home.arpa</domain>
        <domain includeSubdomains="true">internal</domain>
        <domain includeSubdomains="true">intranet</domain>
        <domain includeSubdomains="true">romm</domain>
        <domain includeSubdomains="true">romm.local</domain>
    </domain-config>
</network-security-config>
